# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

downloaded_pdfs/
downloaded_pdfs_all/

# Resources UWI has withdrawn from finder.xml. Corpus data like the above, so
# not tracked - but the README is the only record of what each file was, and
# these PDFs cannot be re-downloaded.
withdrawn_pdfs/*
!withdrawn_pdfs/README.md

# Design docs / specs
docs/

# Generated calibration reports
*_calibration_report.md

.env

# Registry snapshot fetched by validate_corpus.py, and the finder.html sync
# keeps beside it for the term. The test fixture's copies are tracked.
finder.xml
finder.html
!tests/fixtures/**/finder.xml
!tests/fixtures/**/finder.html

# Every source other than root: its PDFs, registry and withdrawn files.
# Corpus data, like downloaded_pdfs/.
sources/
